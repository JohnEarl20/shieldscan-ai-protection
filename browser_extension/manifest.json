{
  "manifest_version": 3,
  "name": "ShieldScan — AI Scam Protection",
  "version": "1.0.0",
  "description": "AI-powered scam protection with real-time threat detection, WireGuard VPN, and cloud malware scanning.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShieldScan AI Protection"
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js",
        "realtime-integration.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:51821/*",
    "https://urlhaus-api.abuse.ch/*",
    "https://checkurl.phishtank.com/*",
    "https://transparencyreport.google.com/*",
    "https://www.virustotal.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tracker_rules",
        "enabled": true,
        "path": "tracker_rules.json"
      }
    ]
  },
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "activeTab",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "history",
    "downloads",
    "nativeMessaging"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "dashboard.html",
        "scanner.html",
        "threat-detector.js",
        "vpn-manager.js",
        "developer-photo.jpg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
